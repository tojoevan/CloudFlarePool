# ===== 数据湖（cloudflarepool）连接 =====
# 数据湖地址（部署后替换为你自己的域名，不要写真实值在此模板中）
DATA_LAKE_BASE=https://your-datalake.example.com
# 与数据湖 wrangler secret put INTERNAL_KEY 设置的值「必须一致」
INTERNAL_KEY=change-me

# ===== 微信小程序（微家事）凭据 =====
# 仅服务端持有，绝不下发前端、绝不进仓库
WX_APPID=wx你的AppID
WX_APPSECRET=你的AppSecret
WX_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# ===== 网关自身 =====
# 监听端口（宝塔 nginx 反代会指向它）
PORT=3000
# 会话令牌签名密钥（请改成随机长串）
SESSION_SECRET=change-me-session-secret
# 本网关服务的租户（对应数据湖 tenants 表的 tenant_id，微家事用 weijiashi）
TENANT_ID=weijiashi
# 会话有效期（秒），默认 30 天
SESSION_TTL=2592000
# 小程序版本号（独立仓库 jiashiben/weijiashi，每次小程序发版时更新，如 0.1.5）。
# 留空则管理后台「版本矩阵」的小程序一项显示「未配置」。
MINIAPP_VERSION=0.1.5

# ===== JWT 签发（B1 双模鉴权） =====
# Ed25519 私钥 PEM（与数据湖 JWT_PUBLIC_KEYS 中的公钥配对）。
# 注意：本仓库的极简 .env 加载器按行解析，故 PEM 必须写成「单行、
# 内部换行用字面量 \n 表示」的形式（见下例）。不要把多行 PEM 直接粘入。
# 生成命令（任选其一）：
#   node: 见 gateway/lib/jwt.js 的 generateKeyPairSync('ed25519')
#   openssl: openssl genpkey -algorithm ed25519 -out jwt_private.pem
# 然后把 PEM 的换行替换为 \n 后填入。例：
#   JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEI....\n-----END PRIVATE KEY-----
# 对应的【公钥】需以 {"gw1":"<base64url 原始 32 字节公钥>"} 的形式
# 通过 `wrangler secret put JWT_PUBLIC_KEYS` 写入数据湖（公钥非机密）。
# 留空则网关不签发 JWT（小程序继续走 X-Sync-Key 代理，行为不变）。
# 仅服务端持有，绝不下发前端、绝不进仓库。
JWT_PRIVATE_KEY=
