# ===== 数据湖（cloudflarepool）连接 =====
# 数据湖地址（部署后替换为你自己的域名，不要写真实值在此模板中）
DATA_LAKE_BASE=https://your-datalake.example.com
# 与数据湖 wrangler secret put INTERNAL_KEY 设置的值「必须一致」
INTERNAL_KEY=change-me

# ===== 微信小程序（微家事）凭据 =====
# 仅服务端持有，绝不下发前端、绝不进仓库
WX_APPID=wx你的AppID
WX_APPSECRET=你的AppSecret
WX_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# ===== 网关自身 =====
# 监听端口（宝塔 nginx 反代会指向它）
PORT=3000
# 会话令牌签名密钥（请改成随机长串）
SESSION_SECRET=change-me-session-secret
# 本网关服务的租户（对应数据湖 tenants 表的 tenant_id，微家事用 weijiashi）
TENANT_ID=weijiashi
# 会话有效期（秒），默认 30 天
SESSION_TTL=2592000
# 小程序版本号（独立仓库 jiashiben/weijiashi，每次小程序发版时更新，如 0.1.5）。
# 留空则管理后台「版本矩阵」的小程序一项显示「未配置」。
MINIAPP_VERSION=0.1.5

# ===== JWT 签发（B1 双模鉴权） =====
# Ed25519 私钥 PEM（与数据湖 JWT_PUBLIC_KEYS 中的公钥配对）。
# 注意：本仓库的极简 .env 加载器按行解析，故 PEM 必须写成「单行、
# 内部换行用字面量 \n 表示」的形式（见下例）。不要把多行 PEM 直接粘入。
# 生成命令（任选其一）：
#   node: 见 gateway/lib/jwt.js 的 generateKeyPairSync('ed25519')
#   openssl: openssl genpkey -algorithm ed25519 -out jwt_private.pem
# 然后把 PEM 的换行替换为 \n 后填入。例：
#   JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEI....\n-----END PRIVATE KEY-----
# 对应的【公钥】需以 {"gw1":"<base64url 原始 32 字节公钥>"} 的形式
# 通过 `wrangler secret put JWT_PUBLIC_KEYS` 写入数据湖（公钥非机密）。
# 留空则网关不签发 JWT（小程序继续走 X-Sync-Key 代理，行为不变）。
# 仅服务端持有，绝不下发前端、绝不进仓库。
JWT_PRIVATE_KEY=

# ===== 机机授权（T3 服务令牌 / agent 访问）=====
# 运营代签（后台「签出访问令牌」）允许签出的租户白名单，逗号分隔。
# 默认 weijiashi + cloudlet，使 agent 可经 /api/t3data/ 读写这两类数据。
MINT_TENANTS=weijiashi,cloudlet
# 网关密钥环文件：保存 T3 服务密钥 raw_secret 以便代签 Bearer（等同私钥文件）。
# 务必指向仓库外、权限 0600 的受保护路径；部署时改为如 /opt/gateway-keyring.json。
# 留空则默认落在网关根目录 ./keyring.json（已在 .gitignore，勿入库）。
# KEYRING_FILE=/opt/gateway-keyring.json

# ===== 一键部署（版本更新按钮）=====
# Cloudflare API Token（用于 wrangler deploy）。用户已确认可在网关服务器落盘。
# 建议：仅授予 weijiashi 这个 Worker 的部署权限（最小权限）；当前按用户决策使用全账户权限。
# 该值由 scripts/setup-server.sh 写入生产服务器网关 .env（gitignore 已忽略 .env）。
CLOUDFLARE_API_TOKEN=
# 仓库在服务器上的克隆目录（部署脚本从此 git pull 并执行 wrangler deploy）
DEPLOY_REPO_DIR=/opt/cloudflarepool
# 站点根目录（SPA 静态资源同步目标）
DEPLOY_WEB_ROOT=/www/wwwroot/home.inkspcl.com
# 部署脚本绝对路径（默认 ${DEPLOY_REPO_DIR}/scripts/deploy.sh，通常无需设置）
# DEPLOY_SCRIPT=/opt/cloudflarepool/scripts/deploy.sh
# 可选：部署后自动重启网关（仅 server.js 变更时需要）。留空=不自动重启（routine 部署无需重启）。
# 例：DEPLOY_RESTART_CMD=pm2 restart home-inkspcl
# DEPLOY_RESTART_CMD=

