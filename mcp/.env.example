# 微家事 MCP Server 配置样例（复制为 .env 后填写真实值，.env 已被 gitignore 保护）
# 真实凭据由 `POST /v1/a/:app/keys`（admin 签发）或运维脚本签发得到，
# 包含一次性返回的 raw_secret（base64url）与 kid。切勿提交真实值到仓库。

# 数据湖地址（未备案域，供集成/海外客户端直连）
WEIJIASHI_DATA_LAKE_URL=https://data.kapibala.icu

# T3 服务令牌三元组
WEIJIASHI_API_KEY_ID=svc_xxxxxx
WEIJIASHI_API_KEY_SECRET=your-base64url-raw-secret-here
WEIJIASHI_API_KEY_KID=svc_xxxxxx.v1

# 租户与应用标识
WEIJIASHI_TENANT_ID=weijiashi
WEIJIASHI_APP_ID=jiashiben
