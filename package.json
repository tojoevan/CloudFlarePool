{
  "name": "cloudflarepool",
  "version": "0.1.0",
  "description": "Multi-tenant data lake on Cloudflare Workers + D1 + R2. Back multiple apps (WeChat mini-programs, web, mobile) from one free Cloudflare stack.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "bundle:test": "esbuild src/index.js --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/test-bundle.mjs",
    "pretest": "npm run bundle:test",
    "test": "node --test test/smoke.test.js",
    "db:migrate:local": "wrangler d1 execute cloudflarepool --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute cloudflarepool --remote --file=schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "miniflare": "^3.20241004.0",
    "wrangler": "^4.120.0"
  }
}
